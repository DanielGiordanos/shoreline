// Oct 15 2026 (n149) — decision #4: personal sign-in. The shared front-desk login (au733@vca.com) is now only the lobby
//   screen's account: it can read the lobby display and nothing else. Every rule that allowed any signed-in account now
//   allows staff() (signed in, and not the lobby account). The lobby display needs a sign-in (it was public).
//   Publish ONLY after every front-desk person has their own account — until then this locks the shared login out.
// Oct 15 2026 (n147) — D-A: On the way rules tightened (tenant + field lists); D-D: sched_months / sched_settings (admin-only writes).
// Oct 28 2026 (assessment) — SGVP intern reviews: sgvp_review_rounds, sgvp_review_assign, sgvp_reviews (the block marked
//   "SGVP intern reviews"; nothing else changed).
rules_version = '2';
// Oct 13 2026 (n127) — On the way: incoming and eta_log (the two blocks marked "Oct 13 (n127)").
// Oct 13 2026 (n126) — verify codes: doc_verify (the block marked "Oct 13 (n126)"; nothing else changed).
// Oct 13 2026 — Pravix Forms (forms/ page + Flow n122): form_templates, visit_docs, form_requests (the three blocks marked "Oct 13"; nothing else changed).
// Oct 12 2026 — codes: tracker codes need the pet's name and stop when the visit ends (the codes block below; nothing else changed).
// Oct 9 2026 (Kura web) — everything in firestore.rules.kura-pending, plus kura/{space}: Kura on shoreline.pravix.app/kura.
// Oct 7 2026 — goes with Flow patch_flow_round2.py. Based on the live rules published Oct 2; changes are marked "Oct 7".
//   · pub: the public may open a visit by its tracker token but no longer list them (staff still list).
//   · lobby: new display-only collection for the waiting-room screen.
//   · messages: readable only under a token you already have; a family message must belong to a real tracker link.
//   · staff can read family messages across visits (Flow's new-message alert), which was always denied.
//   · rules for paths the apps already use that had none (they fell to the final deny): voice_stats,
//     tenants/{tenant}/directory, ts_prefs, ts_usage, ts_stats, and staff saves of ts_settings house_doses / snippets.
// n221: curriculum_requests (change requests with history).
// n223 (Oct 20 2026): au733@vca.com is the managers' read-only curriculum account: it reads curriculum/grid, timeoff and
//   holidays and nothing else (the lobby TV's read is gone; staff() still excludes it everywhere else).
service cloud.firestore {
  match /databases/{database}/documents {

    // n149: the lobby screen account (keep in step with Flow, or/ and treatment/)
    function lobbyAccount() { return request.auth != null && request.auth.token.get('email', '').lower() in ['au733@vca.com']; }
    function staff() { return request.auth != null && !lobbyAccount(); }
        function sgvpAdmin() {
      return request.auth != null
        && ( request.auth.token.email.lower() == 'daniel.giordano@pravix.app' || roleAdmin() );    }

    // n223: the managers' shared account (au733@vca.com) reads the curriculum Overview, read only: the plan (grid),
    // time off and holidays off. Not the change history, not change requests, nothing else in Pravix.
    match /curriculum/{docId} {
      allow read:  if staff() || (lobbyAccount() && docId in ['grid', 'timeoff', 'holidays']);
      allow write: if sgvpAdmin();
    }
    // n221: change requests (an intern asks; a director decides). Staff read; you can only ask as yourself, only
    // as pending; a director approves or declines; the person who asked can withdraw a waiting request.
    match /curriculum_requests/{reqId} {
      allow read:   if staff();
      allow create: if staff()
        && request.resource.data.status == 'pending'
        && request.resource.data.by == request.auth.token.email.lower()
        && request.resource.data.kind in ['swap', 'change', 'timeoff'];
      allow update: if sgvpAdmin()
        || (staff()
            && resource.data.by == request.auth.token.email.lower()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if sgvpAdmin();
    }
    match /sgvp_profiles/{docId} {
      allow read:  if staff();
      allow write: if sgvpAdmin();
    }
    match /sgvp_updates/{docId} {
      allow read:  if staff();
      allow write: if sgvpAdmin();
    }
match /client_intakes/{docId} {
  allow create: if request.resource.data.tenant_id is string
                && request.resource.data.record is map
                && request.resource.size() < 200 * 1024;
  allow read, update, delete: if staff();
}
    match /visits/{id} {
      allow read, write: if staff();
    }

    // Oct 7 — family tracker feed. The document id IS the private tracker token: open by id, never listed by the public.
    match /pub/{token} {
      allow get: if true;
      allow list: if staff();
      allow create, delete: if staff();
      // A family may change only its CPR/DNR choice, only while the visit is open. Flow shows it to staff as
      // "Client request — confirm"; it never becomes the badge on its own. resus_recorded_at may be the server time
      // (FieldValue.serverTimestamp(), checked against request.time) or, as today's tracker sends, a text time.
      allow update: if staff()
        || ( request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resus_pref','resus_status','resus_recorded_at'])
             && resource.data.is_active == true
             && ( request.resource.data.resus_pref == null
                  || ( request.resource.data.resus_pref is string && request.resource.data.resus_pref.size() <= 24 ) )
             && ( request.resource.data.resus_recorded_at == request.time
                  || request.resource.data.resus_recorded_at == null
                  || ( request.resource.data.resus_recorded_at is string && request.resource.data.resus_recorded_at.size() <= 40 ) ) );
    }

    // Oct 7 — waiting-room screen (index.html?display). Display-only copy per visit, keyed by the visit id: no tracker
    // token, owner, phone, room or CPR/DNR. Staff Flow adds it, keeps it current and removes it when the visit ends.
    match /lobby/{id} {
      allow read: if staff();   // n223: the lobby TV is off; au733@vca.com is the managers' curriculum account now
      allow create, update: if staff()
        && request.resource.data.keys().hasOnly(['tenant_id','patient_name','species','breed','age','age_estimated',
                                                 'status','prio','doctor_id','arrival_time','timeline','is_active']);
      allow delete: if staff();
    }

    // Oct 12 — family tracker check-in codes. A code opens a tracker only together with the pet's name: Flow writes
    // codes/{CODE}-{petname} (v:2), and only while the visit is open and before expires_at (30 days after check-in at most).
    // Old code-only documents (codes/{CODE}), closed visits and unknown codes can't be read at all.
    match /codes/{code} {
      allow get: if resource.data.get('v', 0) == 2
        && resource.data.get('is_active', false) == true
        && resource.data.get('expires_at', null) is timestamp
        && resource.data.expires_at > request.time;
      allow list: if false;
      allow write: if staff();
    }

    // Oct 7 — family ↔ staff chat: readable only under a token you already have (pub can't be listed by the
    // public, and the collection-group read below is staff only); a family message must belong to a real tracker link.
    match /messages/{token}/items/{id} {
      allow get, list: if true;
      allow create: if staff()
        || ( request.resource.data.sender == 'client'
             && request.resource.data.body is string
             && request.resource.data.body.size() > 0
             && request.resource.data.body.size() <= 1000
             && exists(/databases/$(database)/documents/pub/$(token)) );
      allow update, delete: if staff();
    }
    // Oct 7 — Flow's "new message from family" listener (collectionGroup('items')).
    match /{path=**}/items/{id} {
      allow read: if staff();
    }

    // Oct 7 — voice command counts (Flow and Treatment Sheets, voice_stats/{tenant}_{day}).
    match /voice_stats/{id} {
      allow read, write: if staff();
    }
    // Oct 7 — shared staff directory roster (Flow reads tenants/shoreline/directory/roster; the Directory app edits it).
    match /tenants/{tenant}/directory/{doc} {
      allow read: if staff();
      allow write: if sgvpAdmin() || (staff() && request.auth.token.directoryEditor == true);
    }

    match /shifts/{tenant} {
      allow get: if true;
      allow write: if staff();
    }
    match /alerts/{tenant} {
      allow get: if true;
      allow write: if staff();
    }

    match /sgvp_mentors/{docId} {
    allow read: if staff();
    allow write: if sgvpAdmin();
    }
    match /sgvp_roles/{docId} {
    allow read: if staff();
    allow write: if sgvpAdmin();
    }

    function roleAdmin() {
    return exists(/databases/$(database)/documents/sgvp_roles/$(request.auth.token.email.lower()))
    && get(/databases/$(database)/documents/sgvp_roles/$(request.auth.token.email.lower())).data.admin == true;
    }


    // Treatment Sheets — Charges code list: staff read; owner writes; 'map' (hospital codes per drug) writable by staff
    match /charge_codes/{doc} {
      allow read: if staff();
      allow write: if (doc == 'map' && staff()) || sgvpAdmin();
    }
    // Treatment Sheets — per-intern draft switch: staff read; owner writes; listed editors may change interns, not editors
    // Oct 7: staff may also save the shared house doses and snippets (the app keeps them on one device until this rule exists)
    match /ts_settings/{doc} {
      allow read: if staff();
      allow write: if sgvpAdmin()
        || ((doc == 'house_doses' || doc == 'snippets') && staff())
        || (resource != null
            && request.auth.token.email.lower() in resource.data.get('editors', [])
            && request.resource.data.get('editors', []) == resource.data.get('editors', []));
    }
    // Oct 7 — Treatment Sheets: each person's language (ts_prefs/{uid}), usage counts and on-time report history
    match /ts_prefs/{uid} {
      allow read, write: if staff() && request.auth.uid == uid;
    }
    match /ts_usage/{id} {
      allow read, write: if staff();
    }
    match /ts_stats/{id} {
      allow read, write: if staff();
    }
    // Oct 9 2026 — Kura stock link (Treatment Sheets store/kura.js → Kura's pull connector). Each recorded dose is one event
    // kura_outbox/{hospital}/events/{eventId}: staff create it once (server time, no Kura field); Kura's own staff account reads
    // them and may only add its acknowledgement field "kura". Events are never changed otherwise or deleted.
    match /kura_outbox/{hospital}/events/{eventId} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.event_id == eventId
        && request.resource.data.hospital == hospital
        && request.resource.data.env is string
        && request.resource.data.env.size() < 20000
        && request.resource.data.written_at == request.time
        && !('kura' in request.resource.data);
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kura']);
      allow delete: if false;
    }
    match /sheets/{sheetId} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.tenant_id is string
        && request.resource.data.status == 'active'
        && request.resource.data.patient is map;
      allow update: if staff()
        && request.resource.data.tenant_id == resource.data.tenant_id;
      allow delete: if false;   // sheets are closed, never deleted
      // charting by day + archived audit (Treatment Sheets)
      match /{sub=**} {
        allow read, create, update: if staff();
        allow delete: if false;
      }
    }
    // Oct 9 2026 — Kura on shoreline.pravix.app/kura (kura/{space}). Only Daniel for now. The page runs Kura's engine on the
    // device; Firebase keeps the shared record: a head {seq}, one log entry per change (written once, never changed or
    // deleted, numbered with no gaps because the head moves with it), full copies in checkpoints/, settings in meta/.
    function kuraOwner() {
      return request.auth != null && request.auth.token.email.lower() == 'daniel.giordano@pravix.app';
    }
    match /kura/{space} {
      allow read: if kuraOwner();
      allow create: if kuraOwner() && request.resource.data.seq == 1;
      allow update: if kuraOwner() && request.resource.data.seq == resource.data.seq + 1;
      allow delete: if false;
      match /log/{entry} {
        allow read: if kuraOwner();
        allow create: if kuraOwner()
          && request.resource.data.seq is int
          && getAfter(/databases/$(database)/documents/kura/$(space)).data.seq == request.resource.data.seq;
        allow update, delete: if false;
        match /parts/{part} {
          allow read: if kuraOwner();
          allow create: if kuraOwner();
          allow update, delete: if false;
        }
      }
      match /checkpoints/{cp} {
        allow read: if kuraOwner();
        allow create: if kuraOwner() && request.resource.data.seq is int;
        allow update, delete: if false;
        match /parts/{part} {
          allow read: if kuraOwner();
          allow create: if kuraOwner();
          allow update, delete: if false;
        }
      }
      match /meta/{doc} {
        allow read, create, update: if kuraOwner();
        allow delete: if false;
      }
    }
    // Oct 13 — Pravix Forms. The hospital's own PDFs and how each box is filled: staff read them (Flow fills them);
    // only the owner / role admins map and publish them (shoreline.pravix.app/forms).
    match /form_templates/{id} {
      allow read: if staff();
      allow write: if sgvpAdmin();
      match /parts/{part} {
        allow read: if staff();
        allow write: if sgvpAdmin();
      }
    }
    // Oct 13 — signed PDFs on a visit. Written once and never changed (only the "printed" note may be added), never deleted.
    // Staff only: none of this is in pub (the family tracker) or lobby (the waiting room).
    match /visit_docs/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.visit_id is string
        && request.resource.data.sha256 is string && request.resource.data.sha256.size() == 64;
      allow update: if staff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['printed_at', 'printed_by']);
      allow delete: if false;
      match /parts/{part} {
        allow read: if staff();
        allow create: if staff();
        allow update, delete: if false;
      }
    }
    // Oct 13 — forms a doctor sends to reception (requested → with the family → signed, or cancelled). Never deleted.
    match /form_requests/{id} {
      allow read, create, update: if staff();
      allow delete: if false;
    }
    // Oct 13 (n126) — verify codes printed on signed PDFs. The document id IS the 16-character code: anyone holding the
    // paper may open that one record, never list them. It holds only the fingerprint, the day it was signed, the
    // hospital and the form's title — no pet, owner, visit or staff. Written once by staff when a form is signed; never
    // changed or deleted.
    match /doc_verify/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if staff()
        && code.matches('^[2-9A-HJ-NP-Z]{16}$')
        && request.resource.data.keys().hasOnly(['v','sha256','signed_on','hospital','title','pages','tenant_id','created_at'])
        && request.resource.data.sha256 is string && request.resource.data.sha256.size() == 64
        && request.resource.data.signed_on is string && request.resource.data.signed_on.size() == 10
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.hospital is string && request.resource.data.hospital.size() <= 80;
      allow update, delete: if false;
    }
    // Oct 13 (n127) — On the way: families who called and are driving in. Staff only (never in pub or lobby); kept, not
    // deleted: when they arrive or aren't coming, Flow clears the town, phone and owner from the record.
    // Oct 15 (n147, decision D-A) — tightened before publishing: the hospital is checked on every read and write, a new
    // record may carry only the fields Flow writes, and an update may change only the arrival fields (never the tenant,
    // the name, who created it or when).
    function otwTenant() { return 'shoreline'; }
    match /incoming/{id} {
      allow read: if staff() && resource.data.tenant_id == otwTenant();
      allow create: if staff()
        && request.resource.data.tenant_id == otwTenant()
        && request.resource.data.status == 'on_the_way'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.keys().hasOnly(['tenant_id','status','name','species','breed','owner','phone','prio','reason',
             'from','leave_min','leave_at','minutes','minutes_source','shift','eta_first','eta_at','eta_lo','eta_hi',
             'eta_updated_at','refreshes','doctor','room_plan','created_at','created_by']);
      allow update: if staff()
        && resource.data.tenant_id == otwTenant()
        && request.resource.data.tenant_id == resource.data.tenant_id
        && request.resource.data.status in ['on_the_way', 'arrived', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','arrived_at','visit_id','from','phone',
             'owner','cancelled_at','cancelled_by','minutes','eta_at','eta_lo','eta_hi','eta_updated_at','refreshes',
             'leave_at','shift','room_plan']);
      allow delete: if false;
    }
    // Oct 13 (n127) — how long arrivals really took vs the estimate, so Flow learns. Town, hour and minutes only.
    // Oct 15 (n147) — the hospital is checked too.
    match /eta_log/{id} {
      allow read: if staff() && resource.data.tenant_id == otwTenant();
      allow create: if staff()
        && request.resource.data.tenant_id == otwTenant()
        && request.resource.data.keys().hasOnly(['tenant_id','town','dow','hour','leave_min','predicted_min','actual_min','source','at'])
        && request.resource.data.predicted_min is int && request.resource.data.actual_min is int;
      allow update, delete: if false;
    }
    // Oct 15 (n147, decision D-D) — the intern schedule (Scheduling page) moves into this project. Anyone may read it, as
    // with the old shoreline-calendar project (the page is public); only a Pravix admin may change it. The plaintext
    // password that used to guard editing is gone from the page.
    match /sched_months/{id} {
      allow read: if true;
      allow write: if sgvpAdmin()
        && id.matches('^[0-9]{4}_[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['days','updatedAt','updatedBy']);
    }
    match /sched_settings/{id} {
      allow read: if true;
      allow write: if sgvpAdmin()
        && id == 'announcement'
        && request.resource.data.keys().hasOnly(['text','updatedAt','updatedBy'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
    }
    // Oct 15 (n148, decision #7) — Rounds' Tomorrow list (Rechecks, Drop-offs, OP Ultrasound), shared by everyone on Rounds.
    // One document per item. Staff of this hospital only; the hospital, the list and who created the item never change.
    match /rounds_queue/{id} {
      allow read: if staff() && resource.data.tenant_id == otwTenant();
      allow create: if staff()
        && request.resource.data.tenant_id == otwTenant()
        && request.resource.data.key in ['recheck', 'dropoff', 'opus']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.done is bool
        && request.resource.data.keys().hasOnly(['tenant_id','key','text','done','done_at','created_at','created_by','updated_at','updated_by']);
      allow update: if staff()
        && resource.data.tenant_id == otwTenant()
        && request.resource.data.done is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','done_at','updated_at','updated_by']);
      allow delete: if staff() && resource.data.tenant_id == otwTenant();
    }
    // Oct 16 (n151) — Anesia: anesthesia records for training cases (residents' teaching cases, not the medical record).
    // Staff of this hospital only. A record is never deleted; its hospital, id, creator and kind never change;
    // once signed, only addenda (and the history and last-changed stamp that go with them) can be added.
    // A save reads the record first inside a transaction, so reading a record that doesn't exist yet is allowed.
    match /anesia_records/{id} {
      allow read: if staff() && (resource == null || resource.data.tenant_id == 'shoreline');
      allow create: if staff()
        && request.resource.data.tenant_id == 'shoreline'
        && request.resource.data.kind in ['training', 'case']
        && (request.resource.data.kind == 'training' || request.resource.data.sheet_id is string)
        && request.resource.data.id == id
        && request.resource.data.status in ['planned', 'active', 'ended', 'signed'];
      allow update: if staff()
        && resource.data.tenant_id == 'shoreline'
        && request.resource.data.tenant_id == 'shoreline'
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.get('sheet_id', null) == resource.data.get('sheet_id', null)
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.status in ['planned', 'active', 'ended', 'signed']
        && (resource.data.status != 'signed'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addenda', 'audit', 'updated_at', 'updated_by']));
      allow delete: if false;
    }
    // Oct 16 (n155) — Anesia: who has a training record open (one small document per person and record, refreshed every minute).
    match /anesia_presence/{id} {
      allow read: if staff() && (resource == null || resource.data.tenant_id == 'shoreline');
      allow create, update: if staff()
        && request.resource.data.tenant_id == 'shoreline'
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.rec + '_' + request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.at is number
        && request.resource.data.keys().hasOnly(['tenant_id', 'rec', 'uid', 'name', 'at']);
      allow delete: if staff() && resource.data.uid == request.auth.uid;
    }
    // ── SGVP intern reviews (sgvp/assessment/) ──────────────────────────────────────────────────────────
    // Daniel opens a review round and assigns evaluators per intern. Every assignment has exactly one review
    // document with the same id (<round>__<intern>__<evaluator email>). An evaluator reads and writes only her
    // own review, only while it is a draft and the round is open; Submit locks it. Daniel and Heather read every
    // review and may reopen a submitted one; nobody can change a submitted review's ratings or text, and nothing
    // is ever deleted. Interns and the managers' account have no assignments, so they can read nothing here.
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    function reviewReader() {
      return request.auth != null && myEmail() in ['daniel.giordano@pravix.app', 'heather.galano@vca.com'];
    }
    match /sgvp_review_rounds/{roundId} {
      allow read: if staff();
      allow create, update: if reviewReader()
        && request.resource.data.keys().hasOnly(['name', 'kind', 'period', 'year', 'interns', 'status',
                                                  'created_at', 'created_by', 'updated_at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.interns is list && request.resource.data.interns.size() <= 20
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if false;
    }
    match /sgvp_review_assign/{aid} {
      allow read: if reviewReader() || (staff() && resource.data.email == myEmail());
      allow create: if reviewReader()
        && request.resource.data.keys().hasOnly(['round', 'intern', 'email', 'evaluator_name', 'record_id',
                                                  'created_at', 'created_by'])
        && request.resource.data.email == request.resource.data.email.lower()
        && aid == request.resource.data.round + '__' + request.resource.data.intern + '__' + request.resource.data.email
        && exists(/databases/$(database)/documents/sgvp_review_rounds/$(request.resource.data.round))
        && request.resource.data.intern in get(/databases/$(database)/documents/sgvp_review_rounds/$(request.resource.data.round)).data.interns
        && request.resource.data.record_id is string && request.resource.data.record_id.size() <= 40;
      allow update: if reviewReader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evaluator_name']);
      // an assignment can be taken back only before the evaluator has started
      allow delete: if reviewReader() && !exists(/databases/$(database)/documents/sgvp_reviews/$(aid));
    }
    match /sgvp_reviews/{aid} {
      function asg() { return get(/databases/$(database)/documents/sgvp_review_assign/$(aid)).data; }
      function roundOpen(r) { return get(/databases/$(database)/documents/sgvp_review_rounds/$(r)).data.status == 'open'; }
      function content() {
        return ['answers', 'notes', 'observations', 'progress', 'updated_at', 'status', 'submitted_at'];
      }
      allow read: if reviewReader() || (staff() && resource.data.email == myEmail());
      allow create: if staff()
        && exists(/databases/$(database)/documents/sgvp_review_assign/$(aid))
        && asg().email == myEmail()
        && roundOpen(asg().round)
        && request.resource.data.keys().hasOnly(['round', 'intern', 'email', 'uid', 'evaluator_name', 'record_id',
                                                  'answers', 'notes', 'observations', 'progress',
                                                  'status', 'created_at', 'updated_at'])
        && request.resource.data.email == myEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.round == asg().round
        && request.resource.data.intern == asg().intern
        && request.resource.data.record_id == asg().record_id
        && request.resource.data.evaluator_name == asg().evaluator_name
        && request.resource.data.status == 'draft'
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;
      allow update: if
        // the evaluator, while it is her draft and the round is open
        ( staff()
          && resource.data.email == myEmail()
          && resource.data.status == 'draft'
          && roundOpen(resource.data.round)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(content())
          && request.resource.data.updated_at == request.time
          && ( (request.resource.data.status == 'draft'
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['submitted_at']))
            || (request.resource.data.status == 'submitted'
                && request.resource.data.submitted_at == request.time) ) )
        // Daniel or Heather reopening a submitted review (ratings and text untouched)
        || ( reviewReader()
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopened_at', 'reopened_by'])
          && request.resource.data.reopened_at == request.time
          && request.resource.data.reopened_by == myEmail() );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}