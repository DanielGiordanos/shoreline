{
  "name": "OR · Pravix",
  "short_name": "OR",
  "description": "The operating rooms at VCA Shoreline: the board, the schedule and every surgical case",
  "id": "/or/",
  "start_url": "/or/",
  "scope": "/or/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A1222",
  "theme_color": "#0A1222",
  "icons": [
    {
      "src": "/assets/img/or-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/img/or-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/img/or-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add case",
      "short_name": "Add case",
      "description": "Book a scheduled case, an add-on or an emergency",
      "url": "/or/#add",
      "icons": [
        {
          "src": "/assets/img/sc-or-add.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Find a case",
      "short_name": "Find",
      "description": "Search cases, patients, surgeons and rooms",
      "url": "/or/#find",
      "icons": [
        {
          "src": "/assets/img/sc-or-find.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Schedule",
      "short_name": "Schedule",
      "description": "Today's cases by room and time",
      "url": "/or/#schedule",
      "icons": [
        {
          "src": "/assets/img/sc-or-schedule.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Display mode",
      "short_name": "Display",
      "description": "The board for the surgery department's wall screen",
      "url": "/or/#display",
      "icons": [
        {
          "src": "/assets/img/sc-or-display.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
