{
  "name": "Flow · Pravix",
  "short_name": "Flow",
  "description": "Patient flow board for VCA Shoreline.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0A1222",
  "theme_color": "#0A1222",
  "icons": [
    {
      "src": "/assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "shortcuts": [
    {
      "name": "New patient",
      "short_name": "New patient",
      "description": "Start intake for a new patient",
      "url": "/#op=new",
      "icons": [
        {
          "src": "/assets/img/sc-flow-new.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Find a patient",
      "short_name": "Find a patient",
      "description": "Search patients, doctors and rooms",
      "url": "/#find",
      "icons": [
        {
          "src": "/assets/img/sc-flow-find.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Patients",
      "short_name": "Patients",
      "description": "Everyone in the hospital, most urgent first",
      "url": "/#view=list",
      "icons": [
        {
          "src": "/assets/img/sc-flow-patients.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Client Display",
      "short_name": "Client Display",
      "description": "The lobby screen for families",
      "url": "/#view=client",
      "icons": [
        {
          "src": "/assets/img/sc-flow-display.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
